{
  "name": "basekit",
  "version": "0.4.0",
  "private": true,
  "description": "Parametric generator for magnetised tabletop miniature bases, with the size embossed inside the model.",
  "homepage": "https://basekit.ras.sh",
  "bugs": "https://github.com/richardsolomou/basekit/issues",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardsolomou/basekit.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "samples": "tsx scripts/exportSamples.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset tag",
    "policy:sync": "ras policy sync",
    "policy:check": "ras policy check",
    "check": "pnpm format:check && pnpm lint && pnpm policy:check && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@posthog/react": "^1.10.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.45.0",
    "manifold-3d": "^3.5.3",
    "opentype.js": "^2.0.0",
    "posthog-js": "^1.430.3",
    "ras-stack": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@playwright/test": "^1.63.0",
    "@posthog/rollup-plugin": "^1.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.15.0"
}
