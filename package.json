{
  "name": "hobbykit",
  "version": "0.16.1",
  "private": true,
  "description": "Parametric generator for tabletop hobby prints: magnetised miniature bases, holders, trays, paint racks, and tokens.",
  "homepage": "https://hobbykit.ras.sh",
  "bugs": "https://github.com/richardsolomou/hobbykit/issues",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardsolomou/hobbykit.git"
  },
  "type": "module",
  "scripts": {
    "dev": "ras dev",
    "build": "ras build",
    "preview": "vite preview",
    "typecheck": "ras typecheck",
    "lint": "ras exec -- oxlint --deny-warnings .",
    "lint:fix": "ras exec -- oxlint --fix .",
    "format": "ras format .",
    "format:check": "ras format --check .",
    "test": "ras test",
    "samples": "tsx scripts/exportSamples.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset tag",
    "check": "ras sync --check && pnpm format:check && pnpm lint && pnpm changesets:check && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "changesets:check": "ras changesets check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.55.0",
    "manifold-3d": "^3.5.4",
    "opentype.js": "^2.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.186.0",
    "shadcn": "^4.21.4",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.13.0"
}
