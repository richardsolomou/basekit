{
  "name": "basekit",
  "version": "0.1.0",
  "private": true,
  "description": "Parametric generator for magnetised tabletop miniature bases, with the size embossed inside the model.",
  "homepage": "https://basekit.ras.sh",
  "bugs": "https://github.com/richardsolomou/basekit/issues",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardsolomou/basekit.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src scripts e2e",
    "lint:fix": "oxlint --fix src scripts e2e",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "samples": "tsx scripts/exportSamples.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.28.0",
    "manifold-3d": "^3.5.1",
    "opentype.js": "^2.0.0",
    "posthog-js": "^1.407.2",
    "ras-stack": "^0.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.5",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.33.0"
}
